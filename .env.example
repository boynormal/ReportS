# Scrapee Firebase Auth
SCRAPEE_EMAIL=may.cashier@scharoenchai.com
SCRAPEE_PASSWORD=

# Tokens expire ~1h (Firebase App Check). Do NOT copy from DevTools manually.
# Run instead:
#   npm run auth          → เปิดเบราว์เซอร์ จับ token ใส่ .env ให้
#   npm run sync:auto     → auth แล้ว sync ต่อทันที
#   scripts\start-web.cmd → เปิดแดชบอร์ด
#   scripts\sync-auto.cmd → auth + sync สำหรับมือหรือ Task Scheduler
# SCRAPEE_ID_TOKEN=
# FIREBASE_APP_CHECK_TOKEN=

# Optional overrides for npm run auth
# SCRAPEE_APP_URL=https://scrapee.app/dashboard
# AUTH_TIMEOUT_MS=180000
# จำ Chrome session ใน .auth/scrapee.json (ค่าเริ่มต้นเก็บไว้). ตั้ง 0 ถ้าจะ login ใหม่ทุกครั้ง
# AUTH_KEEP_SESSION=1

# Postgres on localhost
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# Run mode: bootstrap | incremental | reconcile-month
MODE=incremental

# Date range (YYYY-MM-DD) — required for bootstrap / reconcile-month / compare
START_DATE=2026-01-01
END_DATE=2026-08-31

# Incremental lookback window
LOOKBACK_DAYS=3

# Open / unpaid tickets lookback (createdAt) for alerts — default 90
OPEN_LOOKBACK_DAYS=90

# Dashboard: npm run dev:web  (อ่าน DATABASE_URL จากไฟล์นี้)

# LINE Login (โดเมน HTTPS — callback ต้องตรงกับที่ตั้งใน LINE Developers)
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=
# APP_BASE_URL=https://scrapee.scharoenchai.cloud
# AUTH_SECRET=
# DASHBOARD_ADMIN_LINE_IDS=
